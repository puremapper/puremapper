{
    "name": "puremapper/puremapper",
    "description": "A lightweight PHP data mapper and unit of work for pure PHP entities",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "psr/simple-cache": "^3.0"
    },
    "suggest": {
        "psr/simple-cache": "For metadata caching support (PSR-16)"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PureMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PureMapper\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Pham Thao",
            "email": "phamthao03596@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
